<article class="pcard">
  <div class="pcard-top">
    <div class="avatar lg" style="background:<%= p.avatar_color %>"><%= p.initials %></div>
    <div class="pcard-id">
      <h3><a href="/professionisti/<%= p.slug %>"><%= p.name %></a></h3>
      <p class="meta">📍 <%= p.city %><%= p.region ? ', ' + p.region : '' %></p>
    </div>
    <%- include('favbtn', { p, isFav: favs.has(p.id), back }) %>
  </div>
  <p class="headline"><%= p.headline %></p>
  <%- include('badge', { p }) %>
  <%- include('types', { p }) %>
  <% if (p.sectorList.length) { %><p class="sectors small"><% p.sectorList.slice(0,4).forEach(x => { %><span title="<%= x.name %>"><%= x.icon %> <%= x.name %></span><% }) %></p><% } %>
  <div class="pcard-foot">
    <div class="price"><% if (p.price_from && p.price_unit !== 'preventivo') { %><small>da</small> <% } %><strong><%= fmtPrice(p.price_from, p.price_unit) %></strong></div>
    <a class="btn primary" href="/professionisti/<%= p.slug %>">Profilo</a>
  </div>
  <div class="pcard-flags">
    <% if (p.verified) { %><span class="verified">✔ Verificato</span><% } %>
    <% if (p.rehire_pct != null && p.review_count) { %><span class="small ok">👍 <%= Math.round(p.rehire_pct) %>% lo richiamerebbe</span><% } %>
    <% if (!p.available) { %><span class="unavailable">Poca disponibilità</span><% } %>
  </div>
</article>
