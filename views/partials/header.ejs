<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ProfiliPro Agricoltura</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Figtree:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a href="/" class="logo" aria-label="ProfiliPro Agricoltura, home">
      <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="16" fill="var(--forest)"/><path d="M16 25V12" stroke="var(--wheat)" stroke-width="2" stroke-linecap="round"/><path d="M16 15c-4 0-6-3-6-6 4 0 6 3 6 6Zm0 4c4 0 6-3 6-6-4 0-6 3-6 6Zm0-8c3 0 4.5-2.5 4.5-5-3 0-4.5 2.5-4.5 5Z" fill="var(--wheat)"/></svg>
      <span>ProfiliPro<small>agricoltura</small></span>
    </a>
    <nav class="nav">
      <a href="/cerca?type=formazione">Formazione</a>
      <a href="/cerca?type=consulenza">Consulenza</a>
      <a href="/cerca?type=pratiche">Pratiche e bandi</a>
      <span class="nav-sep" aria-hidden="true"></span>
      <% if (user) { %>
        <a href="/area-personale" class="nav-user"><span class="avatar sm"><%= user.name.split(' ').map(w => w[0]).slice(0,2).join('') %></span><%= user.name.split(' ')[0] %></a>
        <form method="post" action="/esci" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn-link">Esci</button></form>
      <% } else { %>
        <a href="/accedi">Accedi</a>
        <a href="/registrati?ruolo=professionista" class="btn wheat">Sei un professionista?</a>
      <% } %>
    </nav>
  </div>
</header>
<% if (flash) { %><div class="wrap"><div class="flash <%= flash.type %>"><%= flash.text %></div></div><% } %>
<main>
