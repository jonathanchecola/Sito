<div class="rating">
  <span class="score-box <%= p.rating == null ? 'new' : '' %>"><%= p.rating == null ? 'Nuovo' : p.rating.toFixed(1) %></span>
  <% if (p.rating != null) { %><span class="rating-text"><strong><%= p.ratingLabel %></strong> · <%= p.review_count %> recension<%= p.review_count === 1 ? 'e' : 'i' %></span><% } else { %><span class="rating-text muted">Nessuna recensione</span><% } %>
</div>
