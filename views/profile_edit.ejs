<%- include('partials/header') %>
<div class="wrap section narrow-wide">
  <div class="dash-head"><div><h1>Il tuo profilo professionale</h1><p class="muted">Un profilo completo riceve fino a 5 volte più richieste.</p></div>
    <a class="btn" href="/professionisti/<%= p.slug %>">Anteprima ›</a></div>
  <% if (errors.length) { %><div class="flash error"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div><% } %>
  <form method="post" action="/area-personale/profilo" class="card stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h2>Chi sei</h2>
    <label>Titolo professionale*<input name="headline" value="<%= p.headline %>" maxlength="140" placeholder="Es. Formatore sicurezza sul lavoro e RSPP"></label>
    <label>Presentazione*<textarea name="bio" rows="6" maxlength="4000" placeholder="Esperienza, metodo di lavoro, settori e clienti tipici"><%= p.bio %></textarea></label>
    <fieldset><legend>Categorie*</legend><div class="check-grid">
      <% categories.forEach(c => { %><label class="opt"><input type="checkbox" name="categories" value="<%= c.id %>" <%= selected.has(c.id) ? 'checked' : '' %>> <%= c.icon %> <%= c.name %></label><% }) %>
    </div></fieldset>
    <label>Competenze <span class="muted">(separate da virgola)</span><input name="skills" value="<%= p.skills %>" placeholder="Leadership, Public speaking, Excel"></label>

    <h2>Dove e come lavori</h2>
    <div class="row3">
      <label>Città*<input name="city" value="<%= p.city %>" maxlength="80"></label>
      <label>Regione<select name="region"><option value="">—</option><% REGIONS.forEach(r => { %><option <%= p.region === r ? 'selected' : '' %>><%= r %></option><% }) %></select></label>
      <label>Modalità<select name="mode"><% Object.entries(MODES).forEach(([k, l]) => { %><option value="<%= k %>" <%= p.mode === k ? 'selected' : '' %>><%= l %></option><% }) %></select></label>
    </div>
    <div class="row3">
      <label>Tariffa giornaliera (€)<input type="number" name="daily_rate" min="0" value="<%= p.daily_rate ?? '' %>"></label>
      <label>Tariffa oraria (€)<input type="number" name="hourly_rate" min="0" value="<%= p.hourly_rate ?? '' %>"></label>
      <label>Anni di esperienza<input type="number" name="years_experience" min="0" max="60" value="<%= p.years_experience %>"></label>
    </div>

    <h2>Credenziali</h2>
    <label>Lingue <span class="muted">(separate da virgola)</span><input name="languages" value="<%= p.languages %>"></label>
    <label>Certificazioni e titoli <span class="muted">(separate da virgola)</span><input name="certifications" value="<%= p.certifications %>"></label>
    <div class="row3">
      <label>Sito web<input type="url" name="website" value="<%= p.website %>" placeholder="https://"></label>
      <label>LinkedIn<input type="url" name="linkedin" value="<%= p.linkedin %>" placeholder="https://linkedin.com/in/…"></label>
      <label>Partita IVA<input name="vat_number" value="<%= p.vat_number %>" maxlength="20"></label>
    </div>

    <h2>Visibilità</h2>
    <label class="opt"><input type="checkbox" name="available" value="1" <%= p.available ? 'checked' : '' %>> Disponibile per nuovi incarichi</label>
    <label class="opt"><input type="checkbox" name="published" value="1" <%= p.published ? 'checked' : '' %>> Profilo pubblico (visibile nelle ricerche)</label>
    <button class="btn primary big">Salva profilo</button>
  </form>
</div>
<%- include('partials/footer') %>
