<%- include('partials/header') %>
<% const pending = requests.filter(r => r.action).length; %>
<div class="wrap section">
  <div class="dash-head">
    <div><h1>Ciao <%= p.name.split(' ')[0] %></h1><p class="muted">Gestisci il tuo profilo, le richieste di ingaggio e le recensioni.</p></div>
    <div class="dash-actions"><a class="btn" href="/professionisti/<%= p.slug %>">Vedi profilo pubblico</a><a class="btn primary" href="/area-personale/profilo">Modifica profilo</a></div>
  </div>
  <% if (!p.published) { %><div class="flash warn">Il profilo non è pubblico: completalo per comparire nelle ricerche.</div><% } %>
  <div class="kpis">
    <div><strong><%= p.rating != null ? p.rating.toFixed(1) + ' ★' : '–' %></strong><span>valutazione media</span></div>
    <div><strong><%= p.review_count %></strong><span>recensioni</span></div>
    <div><strong><%= pending %></strong><span>richieste che aspettano te</span></div>
    <div><strong><%= requests.filter(r => r.status === 'completata').length %></strong><span>ingaggi completati</span></div>
  </div>
  <div class="dash-grid">
    <section class="card">
      <h2>Richieste e incarichi</h2>
      <%- include('partials/request_list', { requests, side: 'pro', empty: 'Nessuna richiesta ricevuta finora.' }) %>
    </section>
    <%- include('partials/agenda', { agenda }) %>
  </div>
  <section class="card">
    <h2>Ultime recensioni</h2>
    <% if (!reviews.length) { %><p class="muted">Ancora nessuna recensione.</p><% } %>
    <% reviews.slice(0, 5).forEach(r => { %>
      <div class="mini-review"><span class="score-box sm"><%= Number(r.overall).toFixed(1) %></span>
        <div><strong><%= r.title %></strong> <span class="muted small">· <%= r.client_name.split(' ')[0] %>, <%= fmtDate(r.created_at) %></span><br><span class="small"><%= r.pros %></span></div></div>
    <% }) %>
    <% if (reviews.length) { %><a class="btn-link" href="/professionisti/<%= p.slug %>#recensioni">Tutte le recensioni e risposte ›</a><% } %>
  </section>
</div>
<%- include('partials/footer') %>
