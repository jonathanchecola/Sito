<%- include('partials/header') %>
<div class="wrap section">
  <div class="dash-head">
    <div><h1>Ciao <%= user.name.split(' ')[0] %></h1><p class="muted"><%= user.company || 'Area azienda agricola' %></p></div>
    <div class="dash-actions"><a class="btn primary" href="/cerca">Cerca professionisti</a></div>
  </div>
  <div class="dash-grid">
    <section class="card">
      <h2>Le mie richieste</h2>
      <%- include('partials/request_list', { requests, side: 'client', empty: 'Non hai ancora inviato richieste. Cerca un professionista e chiedi un preventivo.' }) %>
    </section>
    <%- include('partials/agenda', { agenda }) %>
  </div>
  <section>
    <h2>I miei preferiti</h2>
    <% if (!favorites.length) { %><div class="card"><p class="muted">Salva i professionisti con il ♥ per ritrovarli qui.</p></div><% } %>
    <% const favs = new Set(favorites.map(f => f.id)); favorites.forEach(p => { %><%- include('partials/card', { p, favs, back: '/area-personale' }) %><% }) %>
  </section>
</div>
<%- include('partials/footer') %>
